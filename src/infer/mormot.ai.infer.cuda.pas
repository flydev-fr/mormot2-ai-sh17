/// native inference engine - CUDA: driver API binding and device context
// - part of the mormot.ai.* extension (LandrixAI)
// - licensed under a MPL/GPL/LGPL three license - see LICENSE
// - backlog B3, slice C1: only what compute needs (device, primary context,
//   modules from PTX, device memory, kernel launch), written after the CUDA
//   Driver API reference and cuda.h of CUDA 13.4.92 (looked up only, see
//   UPSTREAM_BASE); nothing is shipped - the driver's library (nvcuda.dll,
//   libcuda.so.1) is loaded at run time, and without one TInferCuda.Available
//   is false
// - kernels are PTX constants (mormot.ai.infer.cuda.ptx.inc, generated by
//   tools/cuda/build-kernels.sh): no CUDA compiler at build or run time, the
//   driver compiles the PTX for its GPU when a module is loaded
// - the primary context of the device (cuDevicePrimaryCtxRetain), made current
//   on the calling thread by every public method: a TInferCuda may be used
//   from any thread, one at a time
// - 64-bit only (a CUdeviceptr is 64-bit there); elsewhere Available is false
unit mormot.ai.infer.cuda;

{
  *****************************************************************************

    - the CUDA driver types and entry points used for compute
    - TInferCuda: one device and its primary context; TInferCuModule,
      TInferCuBuffer on it; Launch runs a kernel and waits

  *****************************************************************************
}

interface

{$I mormot.defines.inc}

uses
  sysutils,
  math,
  mormot.core.base,
  mormot.core.os,
  mormot.core.unicode,
  mormot.core.text,
  mormot.ai.infer.tensor;

type
  /// a CUDA call failed, or no usable device
  EInferCuda = class(EInferError);

  TCuResult = integer;
  TCuDevice = integer;
  /// CUdeviceptr: a device address, 64-bit
  TCuDevicePtr = Int64;
  PCuDevicePtr = ^TCuDevicePtr;
  /// CUcontext, CUmodule, CUfunction, CUstream: opaque handles
  TCuHandle = pointer;
  PCuHandle = ^TCuHandle;

  /// the driver entry points in use (cuda.h names; the _v2 symbols where the
  // header maps the name to them)
  TInferCuApi = record
    Init: function(aFlags: cardinal): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DriverGetVersion: function(out aVersion: integer): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceGetCount: function(out aCount: integer): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceGet: function(out aDevice: TCuDevice; aOrdinal: integer): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceGetName: function(aName: PAnsiChar; aLen: integer;
      aDevice: TCuDevice): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceGetAttribute: function(out aValue: integer; aAttribute: integer;
      aDevice: TCuDevice): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DeviceTotalMem: function(out aBytes: PtrUInt; aDevice: TCuDevice): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DevicePrimaryCtxRetain: function(out aContext: TCuHandle;
      aDevice: TCuDevice): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    DevicePrimaryCtxRelease: function(aDevice: TCuDevice): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CtxSetCurrent: function(aContext: TCuHandle): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    CtxSynchronize: function: TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ModuleLoadData: function(out aModule: TCuHandle; aImage: pointer): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ModuleUnload: function(aModule: TCuHandle): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    ModuleGetFunction: function(out aFunction: TCuHandle; aModule: TCuHandle;
      aName: PAnsiChar): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    MemAlloc: function(out aPtr: TCuDevicePtr; aBytes: PtrUInt): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    MemFree: function(aPtr: TCuDevicePtr): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    MemcpyHtoD: function(aDst: TCuDevicePtr; aSrc: pointer;
      aBytes: PtrUInt): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    MemcpyDtoH: function(aDst: pointer; aSrc: TCuDevicePtr;
      aBytes: PtrUInt): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    MemcpyDtoD: function(aDst, aSrc: TCuDevicePtr; aBytes: PtrUInt): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    LaunchKernel: function(aFunction: TCuHandle;
      aGridX, aGridY, aGridZ, aBlockX, aBlockY, aBlockZ, aSharedBytes: cardinal;
      aStream: TCuHandle; aParams, aExtra: PPointer): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
    GetErrorName: function(aError: TCuResult; out aText: PAnsiChar): TCuResult;
      {$ifdef OSWINDOWS} stdcall; {$else} cdecl; {$endif}
  end;

  TInferCuda = class;

  /// a module loaded from PTX, with its kernels looked up by name
  TInferCuModule = class
  protected
    fCuda: TInferCuda;
    fModule: TCuHandle;
  public
    /// load aPtx (a zero-terminated PTX text, such as a PTX_* constant): the
    // driver compiles it for the device - raises EInferCuda when it cannot
    constructor Create(aCuda: TInferCuda; aPtx: pointer);
    destructor Destroy; override;
    /// the kernel aName (an extern "C" __global__ function) - raises
    // EInferCuda when the module has none of this name
    function Kernel(const aName: RawUtf8): TCuHandle;
  end;

  /// device memory of a fixed size
  TInferCuBuffer = class
  protected
    fCuda: TInferCuda;
    fPtr: TCuDevicePtr;
    fSize: Int64;
  public
    /// allocate aBytes (at least 1) of device memory - raises EInferCuda
    constructor Create(aCuda: TInferCuda; aBytes: Int64);
    destructor Destroy; override;
    /// copy aBytes from aSource to the buffer at aOffset, waiting until done
    procedure Upload(aOffset: Int64; aSource: pointer; aBytes: Int64);
    /// copy aBytes of the buffer at aOffset to aDest, waiting until done
    procedure Download(aOffset: Int64; aDest: pointer; aBytes: Int64);
    /// copy aBytes of the buffer at aOffset into aDest at aDestOffset on the
    // device, in order with the kernels enqueued before and after (no wait)
    procedure CopyTo(aOffset: Int64; aDest: TInferCuBuffer; aDestOffset,
      aBytes: Int64);
    /// the device address, as a kernel parameter takes it
    property Ptr: TCuDevicePtr read fPtr;
    property Size: Int64 read fSize;
  end;

  /// one CUDA device and its primary context
  // - free every TInferCuModule and TInferCuBuffer made on it first
  TInferCuda = class
  protected
    fLib: TLibHandle;
    fApi: TInferCuApi;
    fDevice: TCuDevice;
    fContext: TCuHandle;
    fDeviceName: RawUtf8;
    fDriverVersion: integer;
    fComputeMajor: integer;
    fComputeMinor: integer;
    fMultiprocessors: integer;
    fMaxSharedPerBlock: integer;
    fTotalMemory: Int64;
    procedure Load(var aProc; aName: PAnsiChar);
    /// raise EInferCuda with the driver's name of aResult when it is no success
    procedure Check(aResult: TCuResult; const aCall: RawUtf8);
    /// make the context current on this thread (every public method does)
    procedure Use;
  public
    /// load the driver library, take the first device and its primary
    // context; raises EInferCuda when any step fails
    constructor Create;
    destructor Destroy; override;
    /// true when a TInferCuda can be created here (tried once, then cached)
    class function Available: boolean;
    /// run aKernel on aGridX * aGridY * aGridZ blocks of aBlockX * aBlockY *
    // aBlockZ threads with aSharedBytes of dynamic shared memory, and wait
    // - aParams: one pointer per kernel parameter, to its value (a
    //   TCuDevicePtr for a pointer parameter, a cardinal for an unsigned int)
    procedure Launch(aKernel: TCuHandle; const aParams: array of pointer;
      aGridX, aBlockX: cardinal; aGridY: cardinal = 1; aGridZ: cardinal = 1;
      aBlockY: cardinal = 1; aBlockZ: cardinal = 1; aSharedBytes: cardinal = 0);
    /// as Launch, without waiting: the kernels run in the order enqueued, after
    // every copy made before (one stream) - Synchronize waits for them
    // - aParams are read by the call itself: their values may change after it
    procedure Enqueue(aKernel: TCuHandle; const aParams: array of pointer;
      aGridX, aBlockX: cardinal; aGridY: cardinal = 1; aGridZ: cardinal = 1;
      aBlockY: cardinal = 1; aBlockZ: cardinal = 1; aSharedBytes: cardinal = 0);
    /// wait for every kernel and copy enqueued; raises the error of one that
    // failed
    procedure Synchronize;
    property Api: TInferCuApi read fApi;
    property Device: TCuDevice read fDevice;
    property DeviceName: RawUtf8 read fDeviceName;
    /// cuDriverGetVersion: 1000 * major + 10 * minor (13040 for CUDA 13.4)
    property DriverVersion: integer read fDriverVersion;
    /// the compute capability, 12.0 for an RTX 5090
    property ComputeMajor: integer read fComputeMajor;
    property ComputeMinor: integer read fComputeMinor;
    property Multiprocessors: integer read fMultiprocessors;
    property MaxSharedPerBlock: integer read fMaxSharedPerBlock;
    property TotalMemory: Int64 read fTotalMemory;
  end;

const
  /// the driver library of this platform
  CUDA_LIBRARY =
    {$ifdef OSWINDOWS} 'nvcuda.dll' {$else} 'libcuda.so.1' {$endif OSWINDOWS};

  CUDA_SUCCESS = 0;
  CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_BLOCK = 8;
  CU_DEVICE_ATTRIBUTE_MULTIPROCESSOR_COUNT = 16;
  CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR = 75;
  CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR = 76;

{$I mormot.ai.infer.cuda.ptx.inc}


implementation

var
  // TInferCuda.Available: 0 = not tried yet, 1 = yes, 2 = no
  CudaAvailable: integer;

type
  /// the floating-point state to restore after a call into the driver
  TCudaFpu = record
    Mask: TFPUExceptionMask;
  end;

/// every floating-point exception masked, as drivers expect (see the same in
// mormot.ai.infer.vulkan): a driver's threads inherit the mask of the thread
// that creates them
function CudaFpuEnter: TCudaFpu;
begin
  result.Mask := GetExceptionMask;
  SetExceptionMask([exInvalidOp, exDenormalized, exZeroDivide, exOverflow,
    exUnderflow, exPrecision]);
end;

procedure CudaFpuLeave(const aState: TCudaFpu);
begin
  SetExceptionMask(aState.Mask);
end;


{ TInferCuModule }

constructor TInferCuModule.Create(aCuda: TInferCuda; aPtx: pointer);
var
  fpu: TCudaFpu;
begin
  inherited Create;
  fCuda := aCuda;
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.ModuleLoadData(fModule, aPtx), 'cuModuleLoadData');
  finally
    CudaFpuLeave(fpu);
  end;
end;

destructor TInferCuModule.Destroy;
var
  fpu: TCudaFpu;
begin
  if fModule <> nil then
  begin
    fpu := CudaFpuEnter;
    try
      try
        fCuda.Use;
        fCuda.fApi.ModuleUnload(fModule);
      except
        // a destructor must not raise: the module goes with the context
      end;
    finally
      CudaFpuLeave(fpu);
    end;
  end;
  inherited Destroy;
end;

function TInferCuModule.Kernel(const aName: RawUtf8): TCuHandle;
var
  fpu: TCudaFpu;
begin
  result := nil;
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.ModuleGetFunction(result, fModule, pointer(aName)),
      'cuModuleGetFunction ' + aName);
  finally
    CudaFpuLeave(fpu);
  end;
end;


{ TInferCuBuffer }

constructor TInferCuBuffer.Create(aCuda: TInferCuda; aBytes: Int64);
var
  fpu: TCudaFpu;
begin
  inherited Create;
  fCuda := aCuda;
  if aBytes < 1 then
    raise EInferCuda.CreateUtf8('%.Create(%): no size', [self, aBytes]);
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.MemAlloc(fPtr, aBytes), 'cuMemAlloc');
  finally
    CudaFpuLeave(fpu);
  end;
  fSize := aBytes;
end;

destructor TInferCuBuffer.Destroy;
var
  fpu: TCudaFpu;
begin
  if fPtr <> 0 then
  begin
    fpu := CudaFpuEnter;
    try
      try
        fCuda.Use;
        fCuda.fApi.MemFree(fPtr);
      except
        // a destructor must not raise: the memory goes with the context
      end;
    finally
      CudaFpuLeave(fpu);
    end;
  end;
  inherited Destroy;
end;

procedure TInferCuBuffer.Upload(aOffset: Int64; aSource: pointer; aBytes: Int64);
var
  fpu: TCudaFpu;
begin
  if (aOffset < 0) or (aBytes < 0) or (aBytes > fSize - aOffset) then // no overflow
    raise EInferCuda.CreateUtf8('%.Upload: % bytes at % of %',
      [self, aBytes, aOffset, fSize]);
  if aBytes = 0 then
    exit;
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.MemcpyHtoD(fPtr + aOffset, aSource, aBytes),
      'cuMemcpyHtoD');
  finally
    CudaFpuLeave(fpu);
  end;
end;

procedure TInferCuBuffer.Download(aOffset: Int64; aDest: pointer; aBytes: Int64);
var
  fpu: TCudaFpu;
begin
  if (aOffset < 0) or (aBytes < 0) or (aBytes > fSize - aOffset) then // no overflow
    raise EInferCuda.CreateUtf8('%.Download: % bytes at % of %',
      [self, aBytes, aOffset, fSize]);
  if aBytes = 0 then
    exit;
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.MemcpyDtoH(aDest, fPtr + aOffset, aBytes),
      'cuMemcpyDtoH');
  finally
    CudaFpuLeave(fpu);
  end;
end;


procedure TInferCuBuffer.CopyTo(aOffset: Int64; aDest: TInferCuBuffer;
  aDestOffset, aBytes: Int64);
var
  fpu: TCudaFpu;
begin
  if (aDest = nil) or (aOffset < 0) or (aDestOffset < 0) or (aBytes < 0) or
     (aBytes > fSize - aOffset) or (aBytes > aDest.fSize - aDestOffset) then
    raise EInferCuda.CreateUtf8('%.CopyTo: % bytes at % to % of %',
      [self, aBytes, aOffset, aDestOffset, aDest]);
  if aBytes = 0 then
    exit;
  fpu := CudaFpuEnter;
  try
    fCuda.Use;
    fCuda.Check(fCuda.fApi.MemcpyDtoD(aDest.fPtr + aDestOffset, fPtr + aOffset,
      aBytes), 'cuMemcpyDtoD');
  finally
    CudaFpuLeave(fpu);
  end;
end;


{ TInferCuda }

procedure TInferCuda.Load(var aProc; aName: PAnsiChar);
begin
  PPointer(@aProc)^ := LibraryResolve(fLib, aName);
  if PPointer(@aProc)^ = nil then
    raise EInferCuda.CreateUtf8('CUDA: no % in %', [aName, CUDA_LIBRARY]);
end;

procedure TInferCuda.Check(aResult: TCuResult; const aCall: RawUtf8);
var
  name: PAnsiChar;
begin
  if aResult = CUDA_SUCCESS then
    exit;
  name := nil;
  if Assigned(fApi.GetErrorName) and
     (fApi.GetErrorName(aResult, name) <> CUDA_SUCCESS) then
    name := nil;
  raise EInferCuda.CreateUtf8('CUDA: % failed with % (%)',
    [aCall, aResult, name]);
end;

procedure TInferCuda.Use;
begin
  Check(fApi.CtxSetCurrent(fContext), 'cuCtxSetCurrent');
end;

constructor TInferCuda.Create;
var
  count, v: integer;
  bytes: PtrUInt;
  name: array[0..255] of AnsiChar;
  fpu: TCudaFpu;
begin
  inherited Create;
  fDevice := -1; // no context retained yet: the destructor releases none
  {$ifndef CPU64}
  raise EInferCuda.Create('CUDA: a 64-bit process is needed');
  {$endif CPU64}
  fLib := LibraryOpen(CUDA_LIBRARY);
  if fLib = TLibHandle(0) then
    raise EInferCuda.CreateUtf8('CUDA: no % (no NVIDIA driver)', [CUDA_LIBRARY]);
  Load(fApi.Init, 'cuInit');
  Load(fApi.DriverGetVersion, 'cuDriverGetVersion');
  Load(fApi.DeviceGetCount, 'cuDeviceGetCount');
  Load(fApi.DeviceGet, 'cuDeviceGet');
  Load(fApi.DeviceGetName, 'cuDeviceGetName');
  Load(fApi.DeviceGetAttribute, 'cuDeviceGetAttribute');
  Load(fApi.DeviceTotalMem, 'cuDeviceTotalMem_v2');
  Load(fApi.DevicePrimaryCtxRetain, 'cuDevicePrimaryCtxRetain');
  Load(fApi.DevicePrimaryCtxRelease, 'cuDevicePrimaryCtxRelease_v2');
  Load(fApi.CtxSetCurrent, 'cuCtxSetCurrent');
  Load(fApi.CtxSynchronize, 'cuCtxSynchronize');
  Load(fApi.ModuleLoadData, 'cuModuleLoadData');
  Load(fApi.ModuleUnload, 'cuModuleUnload');
  Load(fApi.ModuleGetFunction, 'cuModuleGetFunction');
  Load(fApi.MemAlloc, 'cuMemAlloc_v2');
  Load(fApi.MemFree, 'cuMemFree_v2');
  Load(fApi.MemcpyHtoD, 'cuMemcpyHtoD_v2');
  Load(fApi.MemcpyDtoH, 'cuMemcpyDtoH_v2');
  Load(fApi.MemcpyDtoD, 'cuMemcpyDtoD_v2');
  Load(fApi.LaunchKernel, 'cuLaunchKernel');
  Load(fApi.GetErrorName, 'cuGetErrorName');
  fpu := CudaFpuEnter;
  try
    Check(fApi.Init(0), 'cuInit');
    Check(fApi.DriverGetVersion(fDriverVersion), 'cuDriverGetVersion');
    count := 0;
    Check(fApi.DeviceGetCount(count), 'cuDeviceGetCount');
    if count < 1 then
      raise EInferCuda.Create('CUDA: no device');
    Check(fApi.DeviceGet(v, 0), 'cuDeviceGet');
    FillCharFast(name, SizeOf(name), 0);
    Check(fApi.DeviceGetName(@name, SizeOf(name) - 1, v), 'cuDeviceGetName');
    fDeviceName := PAnsiChar(@name);
    Check(fApi.DeviceGetAttribute(fComputeMajor,
      CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR, v), 'cuDeviceGetAttribute');
    Check(fApi.DeviceGetAttribute(fComputeMinor,
      CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MINOR, v), 'cuDeviceGetAttribute');
    Check(fApi.DeviceGetAttribute(fMultiprocessors,
      CU_DEVICE_ATTRIBUTE_MULTIPROCESSOR_COUNT, v), 'cuDeviceGetAttribute');
    Check(fApi.DeviceGetAttribute(fMaxSharedPerBlock,
      CU_DEVICE_ATTRIBUTE_MAX_SHARED_MEMORY_PER_BLOCK, v), 'cuDeviceGetAttribute');
    bytes := 0;
    Check(fApi.DeviceTotalMem(bytes, v), 'cuDeviceTotalMem');
    fTotalMemory := bytes;
    Check(fApi.DevicePrimaryCtxRetain(fContext, v), 'cuDevicePrimaryCtxRetain');
    fDevice := v; // retained: released by the destructor
  finally
    CudaFpuLeave(fpu);
  end;
end;

destructor TInferCuda.Destroy;
var
  fpu: TCudaFpu;
begin
  if fDevice >= 0 then
  begin
    fpu := CudaFpuEnter;
    try
      fApi.DevicePrimaryCtxRelease(fDevice);
    finally
      CudaFpuLeave(fpu);
    end;
  end;
  if fLib <> TLibHandle(0) then
    LibraryClose(fLib);
  inherited Destroy;
end;

class function TInferCuda.Available: boolean;
var
  cu: TInferCuda;
begin
  if CudaAvailable = 0 then
    try
      cu := TInferCuda.Create;
      cu.Free;
      CudaAvailable := 1;
    except
      CudaAvailable := 2;
    end;
  result := CudaAvailable = 1;
end;

procedure TInferCuda.Launch(aKernel: TCuHandle; const aParams: array of pointer;
  aGridX, aBlockX, aGridY, aGridZ, aBlockY, aBlockZ, aSharedBytes: cardinal);
var
  fpu: TCudaFpu;
  params: PPointer;
begin
  if (aKernel = nil) or (aGridX = 0) or (aBlockX = 0) then
    raise EInferCuda.CreateUtf8('%.Launch: no kernel or an empty grid', [self]);
  params := nil;
  if length(aParams) > 0 then
    params := @aParams[0];
  fpu := CudaFpuEnter;
  try
    Use;
    Check(fApi.LaunchKernel(aKernel, aGridX, aGridY, aGridZ, aBlockX, aBlockY,
      aBlockZ, aSharedBytes, nil, params, nil), 'cuLaunchKernel');
    // the launch is asynchronous: its errors surface here
    Check(fApi.CtxSynchronize(), 'cuCtxSynchronize');
  finally
    CudaFpuLeave(fpu);
  end;
end;

procedure TInferCuda.Enqueue(aKernel: TCuHandle; const aParams: array of pointer;
  aGridX, aBlockX, aGridY, aGridZ, aBlockY, aBlockZ, aSharedBytes: cardinal);
var
  fpu: TCudaFpu;
  params: PPointer;
begin
  if (aKernel = nil) or (aGridX = 0) or (aBlockX = 0) then
    raise EInferCuda.CreateUtf8('%.Enqueue: no kernel or an empty grid', [self]);
  params := nil;
  if length(aParams) > 0 then
    params := @aParams[0];
  fpu := CudaFpuEnter;
  try
    Use;
    Check(fApi.LaunchKernel(aKernel, aGridX, aGridY, aGridZ, aBlockX, aBlockY,
      aBlockZ, aSharedBytes, nil, params, nil), 'cuLaunchKernel');
  finally
    CudaFpuLeave(fpu);
  end;
end;

procedure TInferCuda.Synchronize;
var
  fpu: TCudaFpu;
begin
  fpu := CudaFpuEnter;
  try
    Use;
    Check(fApi.CtxSynchronize(), 'cuCtxSynchronize');
  finally
    CudaFpuLeave(fpu);
  end;
end;


end.
