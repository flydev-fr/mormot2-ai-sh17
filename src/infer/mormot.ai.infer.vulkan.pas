    descriptorCount: cardinal;
    stageFlags: TVkFlags;
    pImmutableSamplers: pointer;
  end;

  TVkDescriptorSetLayoutCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    bindingCount: cardinal;
    pBindings: ^TVkDescriptorSetLayoutBinding;
  end;

  TVkPushConstantRange = record
    stageFlags: TVkFlags;
    offset: cardinal;
    size: cardinal;
  end;

  TVkPipelineLayoutCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
