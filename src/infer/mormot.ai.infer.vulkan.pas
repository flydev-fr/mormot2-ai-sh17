/// native inference engine - Vulkan compute: loader binding and device context
// - part of the mormot.ai.* extension (LandrixAI)
// - licensed under a MPL/GPL/LGPL three license - see LICENSE
// - phase 4a of docs/native-inference.md: only what compute needs (instance,
//   device, queue, buffers, compute pipelines, descriptor sets, command
//   buffers, fences), written after the Khronos headers: vulkan_core.h of
//   Vulkan-Headers tag vulkan-sdk-1.4.363.0, commit 6802bb4733b6 (MIT branch of
//   "Apache-2.0 OR MIT", see UPSTREAM_BASE and NOTICE); PasVulkan (commit
//   1467e9b27e02, header 346) looked up only; nothing is shipped - the driver's loader
//   (vulkan-1.dll, libvulkan.so.1) is loaded at run time, and without one
//   TInferVulkan.Available is false
// - shaders are SPIR-V constants (mormot.ai.infer.vulkan.spv.inc, generated by
//   tools/vk/build-shaders.sh): no shader compiler at build or run time
// - 4a keeps every buffer in host-visible coherent memory: correct everywhere,
//   fast nowhere; device-local memory with staging follows with Linear (4b)
// - not yet: macOS (MoltenVK lists its device only with the instance extension
//   VK_KHR_portability_enumeration, which is not requested - Available is
//   false there); 32-bit FPC (the record layout relies on Int64 fields aligned
//   to 8 as MSVC does: Delphi's {$A8} does that, FPC i386 is no target)
unit mormot.ai.infer.vulkan;

{
  *****************************************************************************

    - the Vulkan types and entry points used for compute
    - TInferVulkan: one device and compute queue; TInferVkBuffer,
      TInferVkPipeline on it; Run records, submits and waits

  *****************************************************************************
}

interface

{$I mormot.defines.inc}

uses
  sysutils,
  math,
  mormot.core.base,
  mormot.core.os,
  mormot.core.unicode,
  mormot.core.text,
  mormot.ai.infer.tensor;

{$ifdef FPC}
  {$packrecords C} // the C layout of the Vulkan structures
{$else}
  {$A8}
{$endif FPC}

type
  /// a Vulkan call failed, or no usable device
  EInferVulkan = class(EInferError);

  TVkResult = integer;
  TVkFlags = cardinal;
  TVkBool32 = cardinal;
  /// VkDeviceSize, an uint64_t (Int64 for Delphi 7)
  TVkDeviceSize = Int64;
  /// a dispatchable handle (VkInstance, VkDevice, VkQueue ...): a pointer
  TVkDispatch = pointer;
  /// a non-dispatchable handle (VkBuffer, VkPipeline ...): 64-bit everywhere
  TVkHandle = Int64;
  PVkHandle = ^TVkHandle;

  TVkApplicationInfo = record
    sType: integer;
    pNext: pointer;
    pApplicationName: PAnsiChar;
    applicationVersion: cardinal;
    pEngineName: PAnsiChar;
    engineVersion: cardinal;
    apiVersion: cardinal;
  end;

  TVkInstanceCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    pApplicationInfo: ^TVkApplicationInfo;
    enabledLayerCount: cardinal;
    ppEnabledLayerNames: pointer;
    enabledExtensionCount: cardinal;
    ppEnabledExtensionNames: pointer;
  end;

  TVkQueueFamilyProperties = record
    queueFlags: TVkFlags;
    queueCount: cardinal;
    timestampValidBits: cardinal;
    minImageTransferGranularity: array[0..2] of cardinal;
  end;

  TVkMemoryType = record
    propertyFlags: TVkFlags;
    heapIndex: cardinal;
  end;

  TVkMemoryHeap = record
    size: TVkDeviceSize;
    flags: TVkFlags;
  end;

  TVkPhysicalDeviceMemoryProperties = record
    memoryTypeCount: cardinal;
    memoryTypes: array[0..31] of TVkMemoryType;
    memoryHeapCount: cardinal;
    memoryHeaps: array[0..15] of TVkMemoryHeap;
  end;

  TVkDeviceQueueCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    queueFamilyIndex: cardinal;
    queueCount: cardinal;
    pQueuePriorities: PSingle;
  end;

  TVkDeviceCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    queueCreateInfoCount: cardinal;
    pQueueCreateInfos: ^TVkDeviceQueueCreateInfo;
    enabledLayerCount: cardinal;
    ppEnabledLayerNames: pointer;
    enabledExtensionCount: cardinal;
    ppEnabledExtensionNames: pointer;
    pEnabledFeatures: pointer;
  end;

  TVkBufferCreateInfo = record
    sType: integer;
    pNext: pointer;
    flags: TVkFlags;
    size: TVkDeviceSize;
    usage: TVkFlags;
    sharingMode: integer;
    queueFamilyIndexCount: cardinal;
    pQueueFamilyIndices: PCardinal;
  end;

  TVkMemoryRequirements = record
