// LandrixAI - causal attention with grouped-query heads on the device (phase 4c
// of docs/native-inference.md; CausalRows of the CPU backend in float)
// - y[r, h] = softmax(q[r, h] . keys[0 .. past + r] / sqrt(d)) . values, the
//   keys and values of the KV head h / (heads / kvHeads), rows at kvWidth
// - headDim a multiple of 4 and at most 256 (the query head is kept in shared
//   memory as vec4, the keys read as vec4)
// - one work group of 128 per (head, row, split): the keys of a row are cut
//   into splits ranges (phase 4e, flash-decoding), so a single decoded token
//   still fills the device; the scores go to a scratch buffer (at most
//   past + rows per head and row), then max, exp and sum, then each invocation
//   sums one output dimension (headDim <= 128 * k)
// - splits = 1: y is written normalized; splits > 1: each range writes its
//   unnormalized sums, its maximum and its sum of exponentials to part[], and
//   attnmerge.comp combines them into y
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer BufQ { float q[]; };
layout(std430, binding = 1) readonly buffer BufK { vec4 keys4[]; };
layout(std430, binding = 2) readonly buffer BufV { float vals[]; };
layout(std430, binding = 3) writeonly buffer BufY { float y[]; };
layout(std430, binding = 4) coherent buffer BufS { float sc[]; };
// [heads, rows, splits, headDim + 2]: the sums, then max and sum of exp
layout(std430, binding = 5) writeonly buffer BufP { float part[]; };

layout(push_constant) uniform Push {
  uint rows, heads, headDim, kvHeads, past, splits;
} p;

shared float partial[128];
shared vec4 qs[64]; // the query head: headDim <= 256, a multiple of 4

void main()
{
  uint t = gl_LocalInvocationID.x;
  uint h = gl_WorkGroupID.x;
  uint r = gl_WorkGroupID.y;
  uint s = gl_WorkGroupID.z;
  uint d = p.headDim;
  uint kvw = p.kvHeads * d;
  uint qw = p.heads * d;
  uint g = h / (p.heads / p.kvHeads);
  uint total = p.past + r + 1u;
  // the keys j0 .. j1 - 1 of this split (an empty range for a late split of
  // an early row)
  uint chunk = (total + p.splits - 1u) / p.splits;
  uint j0 = min(total, s * chunk);
  uint j1 = min(total, j0 + chunk);
  uint sbase = (h * p.rows + r) * (p.past + p.rows);
  uint qbase = r * qw + h * d;
  float scale = 1.0 / sqrt(float(d));
  uint d4 = d >> 2;
  for (uint k = t; k < d4; k += 128u)
    qs[k] = vec4(q[qbase + 4u * k], q[qbase + 4u * k + 1u], q[qbase + 4u * k + 2u],
      q[qbase + 4u * k + 3u]);
  barrier();
  // scores and their maximum
  float m = -3.402823e38;
  for (uint j = j0 + t; j < j1; j += 128u)
  {
    uint kb = (j * kvw + g * d) >> 2;
    float sv = 0.0;
    for (uint k = 0u; k < d4; k++)
      sv += dot(qs[k], keys4[kb + k]);
    sv *= scale;
    sc[sbase + j] = sv;
    m = max(m, sv);
  }
  partial[t] = m;
  barrier();
  for (uint w = 64u; w > 0u; w >>= 1)
  {
    if (t < w)
      partial[t] = max(partial[t], partial[t + w]);
    barrier();
  }
  m = partial[0];
  barrier();
  // exponentials and their sum
  float sum = 0.0;
  for (uint j = j0 + t; j < j1; j += 128u)
  {
    float e = exp(sc[sbase + j] - m);
    sc[sbase + j] = e;
    sum += e;
  }
  partial[t] = sum;
  memoryBarrierBuffer();
  barrier();
  for (uint w = 64u; w > 0u; w >>= 1)
  {
    if (t < w)
      partial[t] += partial[t + w];
    barrier();
  }
  sum = partial[0];
  // the weighted values, one output dimension per invocation
  uint pbase = ((h * p.rows + r) * p.splits + s) * (d + 2u);
  for (uint k = t; k < d; k += 128u)
  {
    float acc = 0.0;
    for (uint j = j0; j < j1; j++)
      acc += sc[sbase + j] * vals[j * kvw + g * d + k];
    if (p.splits == 1u)
      y[qbase + k] = acc / sum;
    else
      part[pbase + k] = acc;
  }
  if ((p.splits > 1u) && (t == 0u))
  {
    part[pbase + d] = m;
    part[pbase + d + 1u] = sum;
  }
}
