// LandrixAI - gate = silu(gate) * up on the device (phase 4c of
// docs/native-inference.md; TInferCpuBackend.SwiGlu in float)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer BufG { float g[]; };
layout(std430, binding = 1) readonly buffer BufU { float u[]; };

layout(push_constant) uniform Push { uint n; } p;

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.n)
    return;
  float a = g[i];
  g[i] = (a / (1.0 + exp(-a))) * u[i];
}
