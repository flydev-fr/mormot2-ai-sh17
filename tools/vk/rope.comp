// LandrixAI - rotary positions in place on the device (phase 4c of
// docs/native-inference.md; TInferCpuBackend.Rope: the halves of each head
// rotated by the factors of the token row)
// - one invocation per (row, head, i < headDim / 2)
#version 450

layout(local_size_x = 128) in;

layout(std430, binding = 0) buffer BufX { float x[]; };
layout(std430, binding = 1) readonly buffer BufCos { float cs[]; };
layout(std430, binding = 2) readonly buffer BufSin { float sn[]; };

layout(push_constant) uniform Push {
  uint rows, heads, headDim;
} p;

void main()
{
  uint half_ = p.headDim >> 1;
  uint idx = gl_GlobalInvocationID.x;
  if (idx >= p.rows * p.heads * half_)
    return;
  uint i = idx % half_;
  uint rh = idx / half_; // r * heads + h
  uint r = rh / p.heads;
  float c = cs[r * half_ + i];
  float s = sn[r * half_ + i];
  uint v = rh * p.headDim;
  float a = x[v + i];
  float b = x[v + i + half_];
  x[v + i] = a * c - b * s;
  x[v + i + half_] = b * c + a * s;
}
